---
import { cultureArtisanat } from '../../data/gallery';
import { restaurant, isPublicContact } from '../../data/restaurant';

const phone = restaurant.contact.phone;
const showPhone = phone && isPublicContact(phone.status);
---

<section class="relative overflow-hidden bg-linen text-ink" aria-labelledby="cta-title">
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src="/images/textures/rug-detail-warm.jpg"
      alt=""
      width="1400"
      height="700"
      class="h-full w-full object-cover opacity-40"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-linen via-linen/85 to-linen/70"></div>
  </div>

  <div class="relative grid lg:grid-cols-12">
    <div class="relative min-h-[18rem] lg:col-span-5 lg:min-h-full">
      <img
        src="/images/venue/salon-touareg.jpg"
        alt=""
        width="900"
        height="1200"
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-chocolate/45 mix-blend-multiply" aria-hidden="true"></div>
      <img
        src="/images/overlays/spray-sable-copper.png"
        alt=""
        width="800"
        height="420"
        class="pointer-events-none absolute -bottom-4 -right-6 w-[55%] opacity-70 mix-blend-screen"
        aria-hidden="true"
      />
    </div>

    <div class="section-pad container-site relative lg:col-span-7 lg:max-w-none lg:px-[clamp(2rem,6vw,5rem)]">
      <div data-reveal>
        <p class="eyebrow text-desert-red">Venir</p>
        <h2 id="cta-title" class="mt-3 font-display text-[clamp(2.2rem,4.5vw,3.5rem)] text-chocolate">
          Une place à Bamako
        </h2>
        <p class="mt-5 max-w-md text-lg text-muted">
          Demande de table sans confirmation automatique. Nous rappelons ou répondons pour caler l’horaire.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-6">
          <a
            href="/contact"
            class="inline-flex bg-desert-red px-6 py-4 font-ui text-[0.75rem] font-bold uppercase tracking-[0.14em] text-white no-underline hover:bg-desert-red-hover"
          >
            Écrire une demande
          </a>
          {
            showPhone && phone && (
              <div>
                <a
                  href={phone.href}
                  class="inline-block font-display text-2xl text-chocolate no-underline hover:text-desert-red"
                >
                  {phone.value}
                </a>
              </div>
            )
          }
        </div>
        <p class="mt-8 font-ui text-[0.65rem] uppercase tracking-[0.12em] text-muted">
          Atmosphère : salon tente · {cultureArtisanat.caption}
        </p>
      </div>
    </div>
  </div>
</section>
