---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import { historyBlocks } from '../data/history';
---

<BaseLayout
  title="Notre histoire"
  description="Univers du Restaurant Le Désert à Bamako — hospitalité touareg, salon tente, motifs du Nord et cuisine sahélienne."
>
  <script is:inline>document.body.classList.add('page-interior');</script>
  <PageHero
    eyebrow="Le lieu"
    title="Notre histoire"
    lead="Enseigne, équipe, salon tente : le Nord au cœur de Bamako."
    mediaSrc="/images/venue/salon-touareg.jpg"
    mediaAlt="Salon tente touareg du Restaurant Le Désert"
  />

  <!-- V6 — rythme magazine : asymétrie, jamais de chevauchement texte/image -->
  <section class="bg-linen" aria-label="Chapitres">
    {
      historyBlocks.map((block, i) => {
        const layout = block.layout ?? 'editorial';
        const imageLeft = block.imageLeft ?? i % 2 === 0;

        if (layout === 'immersive' && block.image) {
          return (
            <article class="relative overflow-hidden bg-chocolate text-white">
              <div class="relative aspect-[16/10] w-full md:aspect-[21/9]">
                <img
                  src={block.image}
                  alt={block.imageAlt ?? ''}
                  width="1600"
                  height="900"
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
                <div
                  class="absolute inset-0 bg-gradient-to-t from-chocolate via-chocolate/35 to-transparent"
                  aria-hidden="true"
                />
                <div class="texture-touareg absolute inset-0 opacity-30 mix-blend-soft-light" aria-hidden="true" />
              </div>
              <div class="container-site section-pad pt-10 md:pt-14" data-reveal>
                <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
                  <div class="lg:col-span-7">
                    <p class="eyebrow text-sun">Signature</p>
                    <h2 class="mt-3 font-display text-[clamp(1.85rem,3.5vw,2.85rem)] text-white">
                      {block.title}
                    </h2>
                  </div>
                  <p class="text-lg leading-relaxed text-white/80 lg:col-span-5 lg:pb-1">{block.body}</p>
                </div>
              </div>
            </article>
          );
        }

        if (layout === 'feature' && block.image) {
          return (
            <article
              class:list={[
                'border-b border-chocolate/10',
                i % 2 === 0 ? 'bg-linen' : 'bg-linen-deep/35',
              ]}
            >
              <div class="container-site section-pad">
                <div
                  class:list={[
                    'grid items-start gap-10 lg:grid-cols-12 lg:gap-8',
                    !imageLeft && 'lg:[&>*:first-child]:order-2',
                  ]}
                >
                  <figure class="lg:col-span-7" data-reveal>
                    <div
                      class:list={[
                        'overflow-hidden',
                        imageLeft ? 'aspect-[4/5] md:aspect-[5/6]' : 'aspect-[5/4] md:aspect-[16/11]',
                        imageLeft ? 'lg:mr-[8%]' : 'lg:ml-[8%]',
                      ]}
                    >
                      <img
                        src={block.image}
                        alt={block.imageAlt ?? ''}
                        width="1400"
                        height="1600"
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    </div>
                  </figure>
                  <div
                    class:list={[
                      'lg:col-span-5',
                      imageLeft ? 'lg:pt-[18%]' : 'lg:pt-[12%]',
                    ]}
                    data-reveal
                  >
                    <div class="divider-filigree mb-5 max-w-[8rem]" aria-hidden="true" />
                    <h2 class="font-display text-[clamp(1.85rem,3.5vw,2.75rem)] text-chocolate">
                      {block.title}
                    </h2>
                    <p class="mt-5 max-w-md text-lg leading-relaxed text-muted">{block.body}</p>
                  </div>
                </div>
              </div>
            </article>
          );
        }

        /* editorial — split asymétrique, colonnes disjointes (jamais de chevauchement) */
        return (
          <article
            class:list={[
              'relative overflow-hidden border-b border-chocolate/10',
              i % 2 === 1 ? 'bg-cream' : 'bg-linen',
            ]}
          >
            <div class="texture-touareg absolute inset-0 opacity-40" aria-hidden="true" />
            <div class="relative container-site section-pad">
              <div
                class:list={[
                  'grid items-center gap-12 lg:grid-cols-12 lg:gap-x-12 lg:gap-y-0',
                ]}
              >
                <figure
                  class:list={[
                    'relative z-0 lg:col-span-5 lg:row-start-1',
                    imageLeft ? 'lg:col-start-1' : 'lg:col-start-8',
                  ]}
                  data-reveal
                >
                  <div
                    class:list={[
                      'overflow-hidden',
                      imageLeft ? 'aspect-[4/5] md:aspect-[5/6]' : 'aspect-[5/4] md:aspect-[4/3]',
                    ]}
                  >
                    {block.image && (
                      <img
                        src={block.image}
                        alt={block.imageAlt ?? ''}
                        width="1200"
                        height="1500"
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    )}
                  </div>
                </figure>
                <div
                  class:list={[
                    'relative z-10 lg:col-span-5 lg:row-start-1',
                    imageLeft ? 'lg:col-start-8' : 'lg:col-start-1',
                  ]}
                  data-reveal
                >
                  <p class="eyebrow text-desert-red">Chapitre</p>
                  <h2 class="mt-3 font-display text-[clamp(1.85rem,3.5vw,2.75rem)] text-chocolate">
                    {block.title}
                  </h2>
                  <p class="mt-5 max-w-md text-lg leading-relaxed text-muted">{block.body}</p>
                </div>
              </div>
            </div>
          </article>
        );
      })
    }
  </section>
</BaseLayout>
